# systemd unit for the Watch Together blind relay. Install: see README.md.
[Unit]
Description=Watch Together blind relay
Documentation=https://github.com/watch-together-p2p/watch-together-p2p/tree/main/packages/relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/wt-relay --port 49737
# $STATE_DIRECTORY=/var/lib/wt-relay keeps the seed (the relay's key) across restarts and upgrades.
DynamicUser=yes
StateDirectory=wt-relay
StateDirectoryMode=0700
Restart=always
RestartSec=5
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
